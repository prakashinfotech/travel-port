# Copy this file to .env and fill in real values
# .env is gitignored — never commit it

# Docker image tag (set automatically by GitHub Actions via $GITHUB_SHA)
IMAGE_TAG=latest

# GitHub repo owner in lowercase (e.g. nayanparmar) — used for ghcr.io image path
GITHUB_REPOSITORY_LOWER=your-github-username

# ── Database ──────────────────────────────────────────────────────────────────
# Must be >= 8 chars, contain uppercase, lowercase, digit, and special char
DB_SA_PASSWORD=Travel@Port2026!

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_minimum_32_character_random_string_here
JWT_ISSUER=https://yourdomain.com
JWT_AUDIENCE=https://yourdomain.com

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your@email.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your@email.com

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN_0=http://yourdomain.com
ALLOWED_ORIGIN_1=https://yourdomain.com

# ── Web port ──────────────────────────────────────────────────────────────────
WEB_PORT=80
