# Copy this file to .env and fill in real values
# .env is gitignored — never commit it

# ── Database ──────────────────────────────────────────────────────────────────
# Must be >= 8 chars, contain uppercase, lowercase, digit, and special char
DB_SA_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=TravelPort
JWT_AUDIENCE=TravelPortUsers

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# ── Razorpay ──────────────────────────────────────────────────────────────────
# IMPORTANT: set RAZORPAY_ENABLED=true or real payments will NOT work.
# When false the backend returns a mock order — the Razorpay modal will fail
# to open in production because the fake key is rejected by Razorpay's servers.
#
# Get your keys from https://dashboard.razorpay.com → Settings → API Keys
#   Test keys  → rzp_test_...  (use for staging / QA)
#   Live keys  → rzp_live_...  (use for production)
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN_0=http://localhost
ALLOWED_ORIGIN_1=https://localhost

# ── Groq AI ──────────────────────────────────────────────────────────────────
# Get your free key from https://console.groq.com (no credit card needed)
# Leave blank to disable the AI assistant (chatbot, recommendations, trip planner)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── App Settings ─────────────────────────────────────────────────────────────
# Public-facing URL of the frontend — used in email links (e.g. hotel review link)
# For local Docker: http://localhost  |  For production: https://yourdomain.com
FRONTEND_URL=http://localhost

# ── Web port ──────────────────────────────────────────────────────────────────
WEB_PORT=80
