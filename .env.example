# Copy this file to .env and fill in real values
# .env is gitignored — never commit it

# Docker image tag used by docker-compose
# Keep this as latest for Docker Desktop to automatically use the newest CI image
# Set it to a specific git SHA only when you want to pin or roll back
IMAGE_TAG=latest

# Your Docker Hub username (images are pushed here by CI)
DOCKERHUB_USERNAME=your-dockerhub-username

# ── Database ──────────────────────────────────────────────────────────────────
# Must be >= 8 chars, contain uppercase, lowercase, digit, and special char
DB_SA_PASSWORD=Travel@Port2026!

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_minimum_32_character_random_string_here
JWT_ISSUER=https://yourdomain.com
JWT_AUDIENCE=https://yourdomain.com

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your@email.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your@email.com

# ── Razorpay ──────────────────────────────────────────────────────────────────
# IMPORTANT: set RAZORPAY_ENABLED=true or real payments will NOT work.
# When false the backend returns a mock order — the Razorpay modal will fail
# to open in production because the fake key is rejected by Razorpay's servers.
#
# Get your keys from https://dashboard.razorpay.com → Settings → API Keys
#   Test keys  → rzp_test_...  (use for staging / QA)
#   Live keys  → rzp_live_...  (use for production)
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN_0=http://yourdomain.com
ALLOWED_ORIGIN_1=https://yourdomain.com

# ── Web port ──────────────────────────────────────────────────────────────────
WEB_PORT=80
